<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: an analog clock face reading 10:10.
  Original artwork.

  Hands are symmetric vertical bars rotated into place by a group transform, never hand-drawn as
  slanted outlines. An earlier version wrote each slanted shape by hand and they were asymmetric
  about their own axis, so the hands looked bent and did not meet at the centre. Rotating a
  symmetric bar about the dial centre makes that impossible: the angles become arithmetic.

  Angles clockwise from 12:
    hour   10h10m -> (10 + 10/60) * 30 = 305 deg
    minute 10m     -> 10 * 6           =  60 deg

  Proportions matter at launcher size. The hour hand is deliberately much shorter and noticeably
  thicker than the minute hand — when the two are similar the icon reads as a smudge once masked
  and scaled down.

  The 108x108 viewport has a 66x66 safe zone (radius 33 about 54,54); the face is radius 26 so it
  survives every launcher mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer rim, a shade darker than the face, for a little depth. -->
    <path
        android:fillColor="#FFD8E6F5"
        android:pathData="M54,28 A26,26 0 1 1 53.99,28 Z" />
    <!-- Face -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,30.5 A23.5,23.5 0 1 1 53.99,30.5 Z" />

    <!-- Hour marks at 12, 3, 6, 9. Long and thin reads cleaner than short and fat at this size. -->
    <path android:fillColor="#FF0A64C8" android:pathData="M53,34 h2 v7 h-2 Z" />
    <path android:fillColor="#FF0A64C8" android:pathData="M53,67 h2 v7 h-2 Z" />
    <path android:fillColor="#FF0A64C8" android:pathData="M34,53 h7 v2 h-7 Z" />
    <path android:fillColor="#FF0A64C8" android:pathData="M67,53 h7 v2 h-7 Z" />

    <!-- Hour hand: short and thick. -->
    <group android:rotation="305" android:pivotX="54" android:pivotY="54">
        <path
            android:fillColor="#FF10243A"
            android:pathData="M51.4,56.5 h5.2 v-14.5 a2.6,2.6 0 0 0 -5.2,0 Z" />
    </group>

    <!-- Minute hand: long and slimmer. -->
    <group android:rotation="60" android:pivotX="54" android:pivotY="54">
        <path
            android:fillColor="#FF10243A"
            android:pathData="M52.2,56.5 h3.6 v-22 a1.8,1.8 0 0 0 -3.6,0 Z" />
    </group>

    <!-- Centre pin last, so both hands tuck beneath it. -->
    <path
        android:fillColor="#FF10243A"
        android:pathData="M54,54 m-3.6,0 a3.6,3.6 0 1 0 7.2,0 a3.6,3.6 0 1 0 -7.2,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,54 m-1.3,0 a1.3,1.3 0 1 0 2.6,0 a1.3,1.3 0 1 0 -2.6,0" />
</vector>
