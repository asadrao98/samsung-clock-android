<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget dial: a rounded face with sixty tick marks, every fifth one longer.
  Drawn as a vector so it stays sharp at any widget size. Original artwork.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <!-- Face -->
    <path
        android:fillColor="#FF1D1D20"
        android:pathData="M120,8 A112,112 0 1 1 119.99,8 Z" />
    <path
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="2"
        android:fillColor="@android:color/transparent"
        android:pathData="M120,8 A112,112 0 1 1 119.99,8" />

    <!-- Hour marks, every 30 degrees -->
    <group>
        <path android:fillColor="#FFFAFAFF" android:pathData="M117,20 h6 v22 h-6 Z" />
        <path android:fillColor="#FFFAFAFF" android:pathData="M117,198 h6 v22 h-6 Z" />
        <path android:fillColor="#FFFAFAFF" android:pathData="M20,117 h22 v6 h-22 Z" />
        <path android:fillColor="#FFFAFAFF" android:pathData="M198,117 h22 v6 h-22 Z" />
    </group>
    <group android:rotation="30" android:pivotX="120" android:pivotY="120">
        <path android:fillColor="#66FFFFFF" android:pathData="M118,22 h4 v16 h-4 Z" />
        <path android:fillColor="#66FFFFFF" android:pathData="M118,202 h4 v16 h-4 Z" />
    </group>
    <group android:rotation="60" android:pivotX="120" android:pivotY="120">
        <path android:fillColor="#66FFFFFF" android:pathData="M118,22 h4 v16 h-4 Z" />
        <path android:fillColor="#66FFFFFF" android:pathData="M118,202 h4 v16 h-4 Z" />
    </group>
    <group android:rotation="120" android:pivotX="120" android:pivotY="120">
        <path android:fillColor="#66FFFFFF" android:pathData="M118,22 h4 v16 h-4 Z" />
        <path android:fillColor="#66FFFFFF" android:pathData="M118,202 h4 v16 h-4 Z" />
    </group>
    <group android:rotation="150" android:pivotX="120" android:pivotY="120">
        <path android:fillColor="#66FFFFFF" android:pathData="M118,22 h4 v16 h-4 Z" />
        <path android:fillColor="#66FFFFFF" android:pathData="M118,202 h4 v16 h-4 Z" />
    </group>
</vector>
