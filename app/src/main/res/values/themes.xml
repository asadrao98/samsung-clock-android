<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Deliberately parented on the platform theme rather than a Material Components XML
      theme: the whole UI is Compose, so the only jobs left for the XML theme are the
      pre-first-frame window background and edge-to-edge system bars.
    -->
    <style name="Theme.SamsungClock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      The ringing screen is a display surface rather than a page of the app: always dark with
      white foreground, regardless of the user's theme, so it is legible at 6am.
    -->
    <style name="Theme.SamsungClock.Ringing" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
